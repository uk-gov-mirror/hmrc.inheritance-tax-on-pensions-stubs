meta {
  name: Retrieve - Paid Version 001 (Firstname Surname)
  type: http
  seq: 14
}

get {
  url: {{ihtp_stubs_url}}/etmp/RESTAdapter/pods/reports/ihtp?pstr=24000001IN&paymentReferenceNumber=F246810/26B999999&versionNumber=001
  body: none
  auth: none
}

params:query {
  pstr: 24000001IN
  paymentReferenceNumber: F246810/26B999999
  versionNumber: 001
}

headers {
  correlationid: {{correlationid}}
  X-Message-Type: Request
  X-Originating-System: MDTP
  X-Receipt-Date: 2026-07-24T09:15:00Z
  X-Regime-Type: IHTP
  X-Transmitting-System: HIP
}

tests {
  test("Returns Firstname Surname's paid version 001 report", function () {
      expect(res.getStatus()).to.equal(200);
      expect(res.body.success.reportDetails.ihtVersion).to.equal("001");
      expect(res.body.success.reportDetails.ihtPaid).to.equal("true");
  });
}
