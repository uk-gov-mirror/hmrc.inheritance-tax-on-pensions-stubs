meta {
  name: Overview - Success
  type: http
  seq: 3
}

get {
  url: {{ihtp_stubs_url}}/etmp/RESTAdapter/pods/reports/ihtp-overview?pstr=24000001IN&dateFrom=2026-01-01&dateTo=2026-12-31
  body: none
  auth: none
}

params:query {
  pstr: 24000001IN
  dateFrom: 2026-01-01
  dateTo: 2026-12-31
  ~status: Not reconciled
}

headers {
  correlationid: {{correlationid}}
  X-Message-Type: Request
  X-Originating-System: MDTP
  X-Receipt-Date: 2026-04-10T16:12:49Z
  X-Regime-Type: IHTP
  X-Transmitting-System: HIP
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Returns both versions of the amendment report", function () {
      const reports = res.body.success.ihtpOverview.filter(
        report => report.inheritanceTaxReference === "A556789/26A"
      );
      expect(reports).to.have.lengthOf(2);
      expect(reports.map(report => report.ihtVersion)).to.deep.equal(["001", "002"]);
      expect(reports.map(report => report.paymentReference)).to.deep.equal(
        ["A556789/26A758204", "A556789/26A758204"]
      );
  });
  
  test("Returns two additional paid version 001 reports", function () {
      const reports = res.body.success.ihtpOverview.filter(
        report => report.ihtpStatus === "Paid" && report.ihtVersion === "001"
      );
      expect(reports).to.have.lengthOf(3);
      expect(reports.map(report => report.fbNumber)).to.deep.equal(
        ["119000004360", "119000004362", "119000004363"]
      );
      expect(reports.map(report => report.paymentReference)).to.deep.equal(
        ["A556789/26A758204", "F246810/26B314159", "A975310/26C271828"]
      );
  });
}
